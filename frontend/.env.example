# Copy this file to .env.local for local overrides (optional — defaults to localhost:9000)
# Set this in your Vercel dashboard for production

VITE_API_BASE_URL=https://your-gateway.railway.app

# Google OAuth client ID (Web client). Public value — safe to ship to the browser.
# Create in Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web application).
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
